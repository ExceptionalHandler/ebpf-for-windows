[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = sample_maps_driver.cat
DriverVer   = 04/30/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12
sample_maps_driver_Device_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
sample_maps_driver.sys = 1,,

;;
;; Default install sections
;;

[DefaultInstall.NTamd64]
CopyFiles = Drivers_Dir

[Drivers_Dir]
sample_maps_driver.sys

;;
;; Service installation
;;

[DefaultInstall.NTamd64.Services]
AddService = sample_maps_driver,%SPSVCINST_ASSOCSERVICE%,sample_maps_driver_Service_Inst

[sample_maps_driver_Service_Inst]
DisplayName    = %sample_maps_driver.SVCDESC%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\sample_maps_driver.sys

;;
;; Uninstall sections
;;

[DefaultUninstall.NTamd64]
DelFiles = Drivers_Dir

[DefaultUninstall.NTamd64.Services]
DelService = sample_maps_driver,0x200      ; SPSVCINST_STOPSERVICE

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "eBPF for Windows"
DiskName               = "BPF Maps Sample Driver Installation Disk"
sample_maps_driver.SVCDESC = "BPF Maps Sample Driver"
